      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\For Loop Container\Calculate and Update KPI"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{074A1D6D-EBE7-41E4-9FF1-0D8E69D39CC2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Calculate and Update KPI"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{83D32560-2773-4DAA-BC79-477547871D75}"
              SQLTask:SqlStatementSource="INSERT INTO DWH_KPI (DefectedDataItems, DefectedRecords, UpdateDateTime)&#xA;VALUES (&#xA;    -- Defected Data Items&#xA;    (&#xA;        SELECT &#xA;            CASE &#xA;                WHEN COUNT(*) = 0 THEN 0 -- Handle empty table&#xA;                ELSE &#xA;                    CAST(&#xA;                        (&#xA;                            (COUNT(*) * 8) - -- Total cells (rows * columns)&#xA;                            (COUNT(Emp_No) + COUNT(Name) + COUNT(DOB) + COUNT(Gender) + COUNT(Salary) + COUNT(City) + COUNT(Age) + COUNT(UpdateDateTime))&#xA;                        ) AS FLOAT&#xA;                    ) / &#xA;                    (COUNT(*) * 8) * 100 -- Total cells&#xA;            END&#xA;        FROM Employees&#xA;    ),&#xA;    -- Defected Records&#xA;    (&#xA;        SELECT &#xA;            CASE &#xA;                WHEN COUNT(*) = 0 THEN 0 -- Handle empty table&#xA;                ELSE &#xA;                    CAST(&#xA;                        (&#xA;                            SELECT COUNT(*) &#xA;                            FROM Employees&#xA;                            WHERE Name IS NULL &#xA;                               OR DOB IS NULL &#xA;                               OR Gender IS NULL &#xA;                               OR Salary IS NULL &#xA;                               OR City IS NULL &#xA;                               OR Age IS NULL &#xA;                               OR UpdateDateTime IS NULL&#xA;                        ) AS FLOAT&#xA;                    ) / COUNT(*) * 100 -- Percentage of defected rows&#xA;            END&#xA;        FROM Employees&#xA;    ),&#xA;    -- Update DateTime&#xA;    GETDATE()&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\For Loop Container\Execute Per One Minute"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{9FDA8E03-0E87-4E8E-9235-1FE820DB46B7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute Per One Minute"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{83D32560-2773-4DAA-BC79-477547871D75}"
              SQLTask:SqlStatementSource="WAITFOR DELAY '00:01:00'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
