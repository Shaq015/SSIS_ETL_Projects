    <DTS:Executable
      DTS:refId="Package\Create All Necessary Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{403ADF5F-3EEB-4FD0-B4FC-5F2B525CE9F8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create All Necessary Tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{83D32560-2773-4DAA-BC79-477547871D75}"
          SQLTask:SqlStatementSource="&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Employees' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA; CREATE TABLE Employees (&#xA;    Emp_No INT PRIMARY KEY,&#xA;    Name NVARCHAR(255),&#xA;    DOB DATE,&#xA;    Gender NVARCHAR(255),&#xA;    Salary INT,&#xA;    City NVARCHAR(255),&#xA;    Age INT,&#xA;    UpdateDateTime DATETIME&#xA;  );&#xA;END;&#xA;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'DWH_Employees' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA; CREATE TABLE DWH_Employees (&#xA;    Emp_No INT,&#xA;    Name NVARCHAR(255),&#xA;    DOB DATE,&#xA;    Gender NVARCHAR(255),&#xA;    Salary INT,&#xA;    City NVARCHAR(255),&#xA;    Age INT,&#xA;    UpdateDateTime DATETIME,&#xA;    IsCurrent BIT,                &#xA;    EffectiveStartDate DATETIME,    &#xA;    EffectiveEndDate DATETIME&#xA;  );&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Log' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA; CREATE TABLE Log (&#xA;    EmployeeID INT,&#xA;    FieldName NVARCHAR(255),&#xA;    OldValue NVARCHAR(255),&#xA;    NewValue NVARCHAR(255),&#xA;    UpdateDateTime DATETIME&#xA;  );&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'DWH_KPI' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA; CREATE TABLE DWH_KPI (&#xA;    DefectedDataItems FLOAT,&#xA;    &#xA;    DefectedRecords FLOAT,&#xA;    &#xA;    UpdateDateTime DATETIME&#xA;  );&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Errors' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA; CREATE TABLE Errors (&#xA;    ErrorID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ErrorMessage NVARCHAR(255),&#xA;    &#xA;    ErrorSource NVARCHAR(255),&#xA;    &#xA;    ErrorTime DATETIME DEFAULT GETDATE()&#xA;  );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\For Loop Container"
      DTS:CreationName="STOCK:FORLOOP"
      DTS:Description="For Loop Container"
      DTS:DTSID="{58A5E0F9-CE21-428F-ABE2-BEBC3DE7AEF6}"
      DTS:EvalExpression="True"
      DTS:ExecutableType="STOCK:FORLOOP"
      DTS:LocaleID="-1"
