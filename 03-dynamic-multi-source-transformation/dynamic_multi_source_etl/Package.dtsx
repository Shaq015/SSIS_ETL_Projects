              SQLTask:SqlStatementSource="UPDATE E&#xA;SET &#xA;    E.Name = S.Name,&#xA;    E.DOB = S.DOB,&#xA;    E.Gender = S.Gender,&#xA;    E.Salary = S.Salary,&#xA;    E.CompanyName = S.CompanyName,&#xA;    E.City = S.City,&#xA;    E.State = S.State,&#xA;    E.Email = S.Email,&#xA;    E.CreatedDate = S.CreatedDate&#xA;FROM Employee E&#xA;INNER JOIN Employee_Staging S ON E.Emp_No = S.Emp_No;&#xA;&#xA;ALTER TABLE Employee&#xA;DROP COLUMN GeographyID;&#xA;&#xA;DROP TABLE Employee_Staging;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
