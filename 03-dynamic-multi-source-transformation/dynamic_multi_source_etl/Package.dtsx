          SQLTask:SqlStatementSource="-- Employee Table&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Employee' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA;    CREATE TABLE Employee (&#xA;        Emp_No INT PRIMARY KEY,&#xA;        Name VARCHAR(100),&#xA;        DOB VARCHAR(100),&#xA;        Gender VARCHAR(10),&#xA;        Salary FLOAT,&#xA;        GeographyID VARCHAR(100),&#xA;        CompanyName VARCHAR(100) NULL,&#xA;        City VARCHAR(100) NULL,&#xA;        State VARCHAR(100) NULL,&#xA;        Email VARCHAR(100) NULL,&#xA;        CreatedDate DATETIME DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA;&#xA;-- Hotel Table&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Hotel' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA;    CREATE TABLE Hotel (&#xA;        HotelID INT PRIMARY KEY,&#xA;        HotelName VARCHAR(200),&#xA;        HotelCategory VARCHAR(50),&#xA;        City VARCHAR(100),&#xA;        Country VARCHAR(100),&#xA;        Address VARCHAR(200),&#xA;        Coordinates VARCHAR(50),&#xA;        CreatedDate DATETIME DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA;&#xA;-- Product Table&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Product' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA;    CREATE TABLE Product (&#xA;        ProductId INT PRIMARY KEY,&#xA;        PName VARCHAR(100),&#xA;        SID INT,&#xA;        CreatedDate DATETIME DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA;&#xA;-- Supplier Table&#xA;IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'Supplier' AND TABLE_SCHEMA = 'dbo')&#xA;BEGIN&#xA;    CREATE TABLE Supplier (&#xA;        SupplierID INT PRIMARY KEY,&#xA;        CompanyName VARCHAR(100),&#xA;        CreatedDate DATETIME DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT *&#xA;                         FROM    INFORMATION_SCHEMA.TABLES&#xA;                         WHERE TABLE_NAME = 'Log' AND TABLE_SCHEMA = 'dbo') BEGIN CREATE TABLE Log (LogID INT IDENTITY (1, 1) PRIMARY KEY, ErrorMessage NVARCHAR(255), ErrorSource NVARCHAR(255), ErrorTimestamp DATETIME DEFAULT GETDATE()); &#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
