          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{053172CE-8FFB-4993-B0FF-D3729F821EDA}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create DW Tables"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{68033854-92B8-4DDC-B12D-00BDA11B9536}"
              SQLTask:SqlStatementSource="-- Drop DW tables (fact first)&#xA;IF OBJECT_ID('dbo.F_DETAILS','U') IS NOT NULL DROP TABLE dbo.F_DETAILS;&#xA;IF OBJECT_ID('dbo.D_USER','U')    IS NOT NULL DROP TABLE dbo.D_USER;&#xA;IF OBJECT_ID('dbo.D_EXERCISE','U')IS NOT NULL DROP TABLE dbo.D_EXERCISE;&#xA;&#xA;-- Dimensions&#xA;CREATE TABLE dbo.D_USER (&#xA;    [User]       INT           NOT NULL PRIMARY KEY,&#xA;    BirthDate    DATE          NOT NULL,&#xA;    Height       INT           NOT NULL,&#xA;    Health       INT           NOT NULL,&#xA;    Membership   DECIMAL(10,2) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE dbo.D_EXERCISE (&#xA;    Exercise     INT           NOT NULL PRIMARY KEY,&#xA;    Category     NVARCHAR(50)  NOT NULL,&#xA;    Difficulty   INT           NOT NULL,&#xA;    Calories     DECIMAL(10,4) NOT NULL&#xA;);&#xA;&#xA;-- Fact&#xA;CREATE TABLE dbo.F_DETAILS (&#xA;    [User]      INT           NOT NULL,&#xA;    StartDate   DATE          NOT NULL,&#xA;    [Day]       INT           NOT NULL,&#xA;    [Hour]      INT           NOT NULL,&#xA;    Exercise    INT           NOT NULL,&#xA;    [Weight]    DECIMAL(10,2) NOT NULL,&#xA;&#xA;    -- New financial measures&#xA;    Membership_Fact    DECIMAL(10,2) NOT NULL,&#xA;    Registration_Fact  DECIMAL(10,2) NOT NULL,&#xA;    Supplements_Fact   DECIMAL(10,2) NOT NULL,&#xA;    Equipment_Fact     DECIMAL(10,2) NOT NULL,&#xA;    Delivery_Fact      DECIMAL(10,2) NOT NULL,&#xA;    Total              DECIMAL(10,2) NOT NULL,&#xA;&#xA; -- New quality/result measures (Q8/Q9)&#xA;    Pulse              SMALLINT      NULL,      &#xA;    Actual_Repetition  INT           NOT NULL, &#xA;    Burned_Calories    DECIMAL(10,2) NOT NULL,  &#xA;&#xA;    CONSTRAINT PK_F_DETAILS PRIMARY KEY ([User], StartDate, [Day], [Hour], Exercise),&#xA;&#xA;    CONSTRAINT FK_F_DETAILS_D_USER&#xA;        FOREIGN KEY ([User]) REFERENCES dbo.D_USER([User]),&#xA;&#xA;    CONSTRAINT FK_F_DETAILS_D_EXERCISE&#xA;        FOREIGN KEY (Exercise) REFERENCES dbo.D_EXERCISE(Exercise)&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
