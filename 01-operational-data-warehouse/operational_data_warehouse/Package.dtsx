          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{68033854-92B8-4DDC-B12D-00BDA11B9536}"
              SQLTask:SqlStatementSource="-- Drop order (FK safe)&#xA;IF OBJECT_ID('dbo.CONTENTS','U') IS NOT NULL DROP TABLE dbo.CONTENTS;&#xA;IF OBJECT_ID('dbo.DAYPLANS','U')  IS NOT NULL DROP TABLE dbo.DAYPLANS;&#xA;IF OBJECT_ID('dbo.PROGRAMS','U')  IS NOT NULL DROP TABLE dbo.PROGRAMS;&#xA;IF OBJECT_ID('dbo.EXERCISES','U') IS NOT NULL DROP TABLE dbo.EXERCISES;&#xA;IF OBJECT_ID('dbo.EQUIPMENTS','U')IS NOT NULL DROP TABLE dbo.EQUIPMENTS;&#xA;IF OBJECT_ID('dbo.USERS','U')     IS NOT NULL DROP TABLE dbo.USERS;&#xA;&#xA;-- USERS&#xA;&#xA;CREATE TABLE dbo.USERS (&#xA;    [User]        INT             NOT NULL PRIMARY KEY,&#xA;    BirthDate     DATE            NOT NULL,&#xA;    Height        INT             NOT NULL,&#xA;    Health        INT             NOT NULL,&#xA;    Membership    DECIMAL(10,2)   NOT NULL&#xA;);&#xA;&#xA;&#xA;-- EQUIPMENTS&#xA;&#xA;CREATE TABLE dbo.EQUIPMENTS (&#xA;    Equipment     INT             NOT NULL PRIMARY KEY,&#xA;    Vendor        NVARCHAR(50)    NOT NULL,&#xA;    EquipmentCost DECIMAL(10,2)   NOT NULL&#xA;);&#xA;&#xA;&#xA;-- EXERCISES&#xA;&#xA;CREATE TABLE dbo.EXERCISES (&#xA;    Exercise      INT             NOT NULL PRIMARY KEY,&#xA;    Equipment     INT             NOT NULL,&#xA;    Category      NVARCHAR(50)    NOT NULL,&#xA;    Difficulty    INT             NOT NULL,&#xA;    Calories      DECIMAL(10,4)   NOT NULL,&#xA;    CONSTRAINT FK_EXERCISES_EQUIPMENTS&#xA;        FOREIGN KEY (Equipment)&#xA;        REFERENCES dbo.EQUIPMENTS(Equipment)&#xA;);&#xA;&#xA;&#xA;-- PROGRAMS&#xA;&#xA;CREATE TABLE dbo.PROGRAMS (&#xA;    [User]        INT             NOT NULL,&#xA;    StartDate     DATE            NOT NULL,&#xA;    Registration  DECIMAL(10,2)   NOT NULL,&#xA;    Delivery      DECIMAL(10,2)   NOT NULL,&#xA;    CONSTRAINT PK_PROGRAMS&#xA;        PRIMARY KEY ([User], StartDate),&#xA;    CONSTRAINT FK_PROGRAMS_USERS&#xA;        FOREIGN KEY ([User])&#xA;        REFERENCES dbo.USERS([User])&#xA;);&#xA;&#xA;&#xA;-- DAYPLANS&#xA;&#xA;CREATE TABLE dbo.DAYPLANS (&#xA;    [User]        INT             NOT NULL,&#xA;    StartDate     DATE            NOT NULL,&#xA;    [Day]         INT             NOT NULL,&#xA;    [Weight]      DECIMAL(10,2)   NOT NULL,&#xA;    Supplements   DECIMAL(10,2)   NOT NULL,&#xA;    CONSTRAINT PK_DAYPLANS&#xA;        PRIMARY KEY ([User], StartDate, [Day]),&#xA;    CONSTRAINT FK_DAYPLANS_PROGRAMS&#xA;        FOREIGN KEY ([User], StartDate)&#xA;        REFERENCES dbo.PROGRAMS([User], StartDate)&#xA;);&#xA;&#xA;&#xA;-- CONTENTS&#xA;&#xA;CREATE TABLE dbo.CONTENTS (&#xA;    [User]        INT             NOT NULL,&#xA;    StartDate     DATE            NOT NULL,&#xA;    [Day]         INT             NOT NULL,&#xA;    [Hour]        INT             NOT NULL,&#xA;    Exercise      INT             NOT NULL,&#xA;    Repetitions   INT             NOT NULL,&#xA;    Done          BIT             NOT NULL,&#xA;    Pulse         INT             NULL,&#xA;    CONSTRAINT PK_CONTENTS&#xA;        PRIMARY KEY ([User], StartDate, [Day], [Hour], Exercise),&#xA;    CONSTRAINT FK_CONTENTS_DAYPLANS&#xA;        FOREIGN KEY ([User], StartDate, [Day])&#xA;        REFERENCES dbo.DAYPLANS([User], StartDate, [Day]),&#xA;    CONSTRAINT FK_CONTENTS_EXERCISES&#xA;        FOREIGN KEY (Exercise)&#xA;        REFERENCES dbo.EXERCISES(Exercise)&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
