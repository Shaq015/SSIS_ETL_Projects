                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH N AS (
    SELECT TOP (10)
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n
    FROM sys.all_objects
)
SELECT
    n AS [User],
    DATEADD(DAY, -n, CAST(GETDATE() AS DATE)) AS StartDate,
    1 AS [Day],
    CAST(70 + (n * 2) AS DECIMAL(10,2)) AS [Weight],
    CAST(n * 5 AS DECIMAL(10,2)) AS Supplements
FROM N
ORDER BY n;</property>
