                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH N AS (
    SELECT TOP (10)
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n
    FROM sys.all_objects
)
SELECT
    n AS [User],
    DATEADD(DAY, -n, CAST(GETDATE() AS DATE)) AS StartDate,
    CAST(50 + (n * 10) AS DECIMAL(10,2)) AS Registration,
    CAST(10 + (n * 2) AS DECIMAL(10,2)) AS Delivery
FROM N
ORDER BY n;</property>
