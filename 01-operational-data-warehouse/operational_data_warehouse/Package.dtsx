                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH N AS (
    SELECT TOP (10)
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n
    FROM sys.all_objects
)
SELECT
    n AS Exercise,
    n AS Equipment,   
    CHOOSE(((n - 1) % 5) + 1,
           N'Strength', N'Cardio', N'Core', N'Flexibility', N'HIIT') AS Category,
    ((n - 1) % 5) + 1 AS Difficulty,
    CAST(0.05 + (n * 0.01) AS DECIMAL(10,4)) AS Calories
FROM N
ORDER BY n;</property>
